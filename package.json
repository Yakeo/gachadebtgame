{
  "name": "gacha-debt",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "art:manifest": "node scripts/gen-portrait-manifest.mjs",
    "art:verify": "node scripts/verify-deployed-art.mjs",
    "db:supabase": "node scripts/apply-supabase-schema.mjs",
    "db:diagnose": "node scripts/diagnose-supabase.mjs",
    "e2e": "node scripts/e2e-check.mjs",
    "test": "tsx --test tests/*.test.ts tests/*.test.mjs",
    "test:unit": "tsx --test tests/game-engine.test.ts",
    "test:diag": "node --test tests/diagnostics.test.mjs",
    "test:art": "node --test tests/assets.test.mjs",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "test:kits": "tsx --test tests/kits.test.ts",
